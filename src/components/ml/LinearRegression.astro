---
// src/components/ml/LinearRegression.astro
interface Props {
  points?: number;
  learningRate?: number;
  steps?: number;
}
const { points = 40, learningRate = 0.3, steps = 300 } = Astro.props;
---
<linear-regression-demo data-points={points} data-lr={learningRate} data-steps={steps}>
  <canvas width="600" height="380"></canvas>
  <div class="controls">
    <button type="button">Restart</button>
    <span class="stats"></span>
  </div>
</linear-regression-demo>

<script>
  type Point = { x: number; y: number };

  class LinearRegressionDemo extends HTMLElement {
    frame = 0;

    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const ctx = canvas.getContext('2d')!;
      const stats = this.querySelector('.stats')!;
      const button = this.querySelector('button')!;
      const n = Number(this.dataset.points);
      const lr = Number(this.dataset.lr);
      const maxSteps = Number(this.dataset.steps);
      const W = canvas.width, H = canvas.height, pad = 30;

      let data: Point[] = [];
      let m = 0, b = 0.5, step = 0;

      const px = (x: number, y: number): [number, number] => [
        pad + x * (W - 2 * pad),
        H - pad - y * (H - 2 * pad),
      ];

      const init = () => {
        data = Array.from({ length: n }, () => {
          const x = Math.random();
          return { x, y: 0.7 * x + 0.15 + (Math.random() - 0.5) * 0.2 };
        });
        m = 0; b = 0.5; step = 0;
      };

      const draw = (loss: number) => {
        ctx.clearRect(0, 0, W, H);

        // residuals
        ctx.strokeStyle = 'rgba(239, 68, 68, 0.4)';
        for (const p of data) {
          ctx.beginPath();
          ctx.moveTo(...px(p.x, p.y));
          ctx.lineTo(...px(p.x, m * p.x + b));
          ctx.stroke();
        }

        // points
        ctx.fillStyle = '#3b82f6';
        for (const p of data) {
          ctx.beginPath();
          ctx.arc(...px(p.x, p.y), 4, 0, Math.PI * 2);
          ctx.fill();
        }

        // fitted line
        ctx.strokeStyle = '#f97316';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(...px(0, b));
        ctx.lineTo(...px(1, m + b));
        ctx.stroke();
        ctx.lineWidth = 1;

        stats.textContent =
          `step ${step} · y = ${m.toFixed(2)}x + ${b.toFixed(2)} · MSE ${loss.toFixed(4)}`;
      };

      const loop = () => {
        let dm = 0, db = 0, loss = 0;
        for (const p of data) {
          const err = m * p.x + b - p.y;
          dm += err * p.x;
          db += err;
          loss += err * err;
        }
        m -= (lr * 2 * dm) / n;
        b -= (lr * 2 * db) / n;
        step++;
        draw(loss / n);
        if (step < maxSteps) this.frame = requestAnimationFrame(loop);
      };

      const start = () => {
        cancelAnimationFrame(this.frame);
        init();
        loop();
      };

      button.addEventListener('click', start);
      start();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
    }
  }

  customElements.define('linear-regression-demo', LinearRegressionDemo);
</script>

<style>
  linear-regression-demo { display: block; margin: 2rem 0; }
  canvas { width: 100%; height: auto; border: 1px solid #e5e7eb; border-radius: 8px; }
  .controls { display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem; font-size: 0.9rem; }
  .stats { font-family: monospace; color: #6b7280; }
</style>